:: StoryStylesheet [stylesheet]
#ui-bar {
  display: none;
}

#story {
  margin-left: 3.5em;
}

#passages {
  background: #eee9dc;
  padding: 3em;
  margin: 3em auto;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
}

h1 {
  font-family: Georgia, serif;
  letter-spacing: 0.05em;
}

a {
  color: #5b4035;
}

a:hover {
  color: #8a5a44;
}

.medical-record {
  background: #f4f1e8;
  border: 1px solid #999;
  padding: 2em;
  font-family: "Courier New", monospace;
  line-height: 1.6;
}

.medical-record h1 {
  font-size: 1.4em;
  text-align: center;
  letter-spacing: 0.15em;
}

.medical-record hr {
  border: 0;
  border-top: 1px solid #999;
  margin: 2em 0;
}

.dream-diary {
  background: #e4e0ea;
  padding: 2.5em;
  font-family: Georgia, serif;
  font-style: italic;
  line-height: 1.8;
}

.dream-diary h1 {
  font-style: normal;
  font-size: 1.5em;
  text-align: center;
}

.government-document {
  background: #e8e5d8;
  border: 2px solid #333;
  padding: 2.5em;
  font-family: "Courier New", monospace;
}

.government-document h1 {
  font-family: "Courier New", monospace;
  font-size: 1.2em;
  text-align: center;
}

.government-document .redacted {
  letter-spacing: 0.1em;
}

.student-notes {
  background: #f7f0c8;
  padding: 2em;
  font-family: "Comic Sans MS", cursive;
  transform: rotate(-1deg);
  box-shadow: 2px 3px 8px rgba(0, 0, 0, 0.15);
}

.student-notes h2 {
  font-size: 1.3em;
}